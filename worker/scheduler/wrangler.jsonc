{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "fx-terminal-scheduler",
  "main": "index.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["15,30,45 15,16,17 * * *", "0,15,30,45 20,21 * * 6"]
  },
  "vars": { "TERMINAL_ORIGIN": "https://fx-macro-terminal.hysnzz.chatgpt.site" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
